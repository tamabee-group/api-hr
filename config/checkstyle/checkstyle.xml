<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Tamabee API-HR Checkstyle Configuration
    ========================================
    Rules vừa phải cho project đang phát triển.
    Tương đương ESLint "recommended" config ở frontend.
    Có thể siết chặt dần sau khi deploy thành công.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Không cho phép tab, chỉ dùng space -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- File phải kết thúc bằng newline -->
    <module name="NewlineAtEndOfFile">
        <property name="severity" value="info"/>
    </module>

    <!-- Giới hạn độ dài file: 1600 dòng (cảnh báo) -->
    <module name="FileLength">
        <property name="max" value="1600"/>
        <property name="severity" value="warning"/>
    </module>

    <!-- Độ dài dòng tối đa 150 ký tự (rộng hơn default 80) -->
    <module name="LineLength">
        <property name="max" value="150"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
        <property name="severity" value="warning"/>
    </module>

    <module name="TreeWalker">
        <!-- ========== NAMING CONVENTIONS ========== -->

        <!-- Class/Interface phải PascalCase -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
                     value="Tên class/interface ''{0}'' phải viết PascalCase."/>
        </module>

        <!-- Method phải camelCase -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
                     value="Tên method ''{0}'' phải viết camelCase."/>
        </module>

        <!-- Parameter phải camelCase -->
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Local variable phải camelCase -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Constant phải UPPER_SNAKE_CASE -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$|^log(ger)?$"/>
        </module>

        <!-- Package name phải lowercase -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z_][a-z0-9_]*)*$"/>
        </module>

        <!-- ========== IMPORTS ========== -->

        <!-- Không cho import * (wildcard) -->
        <module name="AvoidStarImport">
            <property name="severity" value="warning"/>
        </module>

        <!-- Không cho import thừa -->
        <module name="UnusedImports">
            <property name="severity" value="warning"/>
        </module>

        <!-- Không cho import trùng lặp -->
        <module name="RedundantImport">
            <property name="severity" value="warning"/>
        </module>

        <!-- ========== CODE STYLE ========== -->

        <!-- Method tối đa 170 dòng -->
        <module name="MethodLength">
            <property name="max" value="170"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- Tối đa 12 parameters cho method -->
        <module name="ParameterNumber">
            <property name="max" value="12"/>
            <property name="severity" value="warning"/>
        </module>

        <!-- ========== BRACES ========== -->

        <!-- Bắt buộc có {} cho if, else, for, while, do -->
        <module name="NeedBraces">
            <property name="severity" value="error"/>
        </module>

        <!-- ========== WHITESPACE ========== -->

        <!-- Khoảng trắng sau dấu phẩy, semicolon -->
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI"/>
        </module>

        <!-- Khoảng trắng quanh operators -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <property name="severity" value="info"/>
        </module>

        <!-- ========== MISCELLANEOUS ========== -->

        <!-- Không được có System.out.println (dùng Logger thay thế) -->
        <module name="Regexp">
            <property name="format" value="System\.(out|err)\.(print|println)"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Không dùng System.out/err. Hãy dùng Logger (SLF4J)."/>
            <property name="severity" value="error"/>
        </module>

        <!-- Modifier order: public static final, không phải static public final -->
        <module name="ModifierOrder"/>

        <!-- Không có modifier thừa -->
        <module name="RedundantModifier">
            <property name="severity" value="info"/>
        </module>

        <!-- Override phải có @Override annotation -->
        <module name="MissingOverride">
            <property name="severity" value="warning"/>
        </module>

        <!-- Suppression: cho phép @SuppressWarnings -->
        <module name="SuppressWarningsHolder"/>
    </module>

    <!-- Cho phép suppress bằng @SuppressWarnings annotation -->
    <module name="SuppressWarningsFilter"/>
</module>
