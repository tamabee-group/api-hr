# ============================================================
# Tamabee API-HR — Production Environment Variables
# ============================================================
# Copy file này thành .env trên VPS:
#   cp .env.production.example .env
#   nano .env  # Điền giá trị thật
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=tamabee_master
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                    # Bắt buộc: đặt password mạnh

# ---- JWT ----
JWT_SECRET=                           # Bắt buộc: random string ít nhất 64 ký tự
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=2592000000

# ---- Mail ----
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=info@yourdomain.com
MAIL_PASSWORD=                        # Bắt buộc: mail password
MAIL_FROM=Tamabee <info@yourdomain.com>

# ---- App ----
ADMIN_EMAIL=admin@yourdomain.com
FRONTEND_URL=https://yourdomain.com
BASE_URL=https://api.yourdomain.com

# ---- Google Calendar ----
GOOGLE_CALENDAR_API_KEY=

# ---- Grafana ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=                     # Bắt buộc: đặt password cho Grafana dashboard
GRAFANA_ROOT_URL=http://localhost:3001
