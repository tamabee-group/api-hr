# ============================================================
# Tamabee API-HR — Development Environment Variables
# ============================================================
# Copy file này thành .env:
#   cp .env.example .env
# ============================================================

SERVER_PORT=8081

# ---- Database ----
DATABASE_URL=jdbc:postgresql://localhost:5432/tamabee_master
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_db_password

# ---- SSH Tunnel (optional, for remote DB) ----
DATABASE_TUNNEL_ENABLED=false
SSH_HOST=your_vps_ip
SSH_PORT=22
SSH_USERNAME=your_ssh_user
SSH_PASSWORD=your_ssh_password
LOCAL_PORT=5433
REMOTE_HOST=localhost
REMOTE_PORT=5432

# ---- JWT ----
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_STRING_AT_LEAST_64_CHARACTERS_LONG
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=2592000000

# ---- Mail ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=Tamabee <your_email@gmail.com>

# ---- App ----
ADMIN_EMAIL=admin@yourdomain.com
FRONTEND_URL=https://localhost:3000
BASE_URL=https://localhost:8081

# ---- Google Calendar ----
GOOGLE_CALENDAR_API_KEY=
